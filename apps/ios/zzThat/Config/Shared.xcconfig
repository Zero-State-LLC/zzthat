// Settings every configuration shares (runtime.md, Build configurations).
// No secrets. Values that differ per build are in Demo, Local, and Release.

ZZ_SUPPORT_EMAIL = support@zer0state.com
// The marketing site's privacy page (ZQ25). Not published yet; Danny publishes it.
ZZ_PRIVACY_URL = https:/$()/zero-state-llc.github.io/zzthis/privacy/
// The Terms of Use (zzThis D-2026-10-13-04, RM-103). A placeholder on the
// zzThat host that D-2026-10-11-09 proposes, never a zzThis host
// (D-2026-10-11-07), until Michael approves the Terms and Danny picks the
// host. Release injects its own value. Empty hides the link.
ZZ_TERMS_URL = https:/$()/zzthat.com/terms/
CODE_SIGN_ENTITLEMENTS = zzThat/Config/zzThat.entitlements

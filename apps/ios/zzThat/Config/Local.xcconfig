// Local: the local zzThis Worker (npm run dev:api) and developer sign-in.
#include "Shared.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = com.zer0state.zzthat.local
ZZ_DISPLAY_NAME = zzThat Local
ZZ_BUILD = local
ZZ_API_ORIGIN = http:/$()/localhost:8787
// Placeholders until Danny creates the Google clients. The app hides the
// Google button while either value is still "unset" (runtime.md, iOS Google setup).
ZZ_GOOGLE_IOS_CLIENT_ID = unset
ZZ_GOOGLE_REVERSED_CLIENT_ID = unset
INFOPLIST_FILE = zzThat/Config/Info-Local.plist
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) ZZ_LOCAL

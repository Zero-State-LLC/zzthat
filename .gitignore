# Paths the specs say are generated or local, never committed.
# Keep this list in sync with runtime.md, Project structure (tasks.md T001).
.zzthis-pin/
apps/ios/*.xcodeproj/
xcuserdata/
DerivedData/
.build/
.swiftpm/
apps/android/.gradle/
apps/android/.kotlin/
**/build/
apps/android/local.properties
# Signing keys are Actions secrets, never files in the tree (T093).
*.jks
*.keystore
# The iOS distribution certificate and profile are Actions secrets too (T107).
*.p12
*.mobileprovision

